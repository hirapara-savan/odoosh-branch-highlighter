{
  "manifest_version": 3,
  "name": "Odoo.sh Branch Highlighter",
  "version": "1.0",
  "description": "Highlights Production, Staging, and Development branch sections on Odoo.sh with custom colors",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.odoo.sh/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}